// Headless smoke test: node tests/smoke.js  (needs playwright; serves on :8777)
const {chromium}=require(process.env.PW||'playwright'); const http=require('http'),fs=require('fs'),path=require('path');
const root=path.join(__dirname,'..'); const types={'.html':'text/html','.js':'text/javascript','.json':'application/json','.jpg':'image/jpeg','.png':'image/png'};
const srv=http.createServer((q,r)=>{ const f=path.join(root,decodeURIComponent(q.url.split('?')[0])==='/'?'index.html':decodeURIComponent(q.url.split('?')[0])); fs.readFile(f,(e,d)=>{ if(e){r.writeHead(404);return r.end();} r.writeHead(200,{'content-type':types[path.extname(f)]||'application/octet-stream'}); r.end(d);}); }).listen(8777);
(async()=>{ let b; try{ b=await chromium.launch(); }catch(e){ b=await chromium.launch({executablePath:'/usr/bin/google-chrome'}); }
  const p=await b.newPage({viewport:{width:1280,height:720}}); const errs=[]; p.on('console',m=>{ if(m.type()==='error') errs.push(m.text()); }); p.on('pageerror',e=>errs.push(String(e)));
  await p.goto('http://localhost:8777/'); await p.waitForTimeout(1500); await p.screenshot({path:root+'/tests/shot_menu.png'});
  await p.evaluate(()=>__game.scene.start('HeroSelect')); await p.waitForTimeout(500); await p.screenshot({path:root+'/tests/shot_heroes.png'});
  await p.evaluate(()=>{ __game.scene.stop('HeroSelect');__game.scene.stop('Menu'); __game.scene.start('Game',{hero:'david'}); }); await p.waitForTimeout(800);
  // build via real taps: select sling, tap map
  await p.mouse.click(76,665); await p.mouse.click(330,300);
  await p.mouse.click(226,665); await p.mouse.click(420,440);
  await p.mouse.click(526,665); await p.mouse.click(700,320);
  const r1=await p.evaluate(()=>{ const s=__scene; s.manna+=2000; s.startWave(); s.speed=2; return {towers:s.towers.length,manna:s.manna}; });
  await p.waitForTimeout(3500); await p.evaluate(()=>{__scene.hero.tx=255;__scene.hero.ty=160;});
  await p.evaluate(()=>__scene.useSkill(0)); await p.screenshot({path:root+'/tests/shot_wave.png'});
  await p.waitForTimeout(9000);
  const r2=await p.evaluate(()=>({wave:__scene.wave,active:__scene.waveActive,lives:__scene.lives,heroHp:Math.round(__scene.hero.hp),earned:__scene.earned,enemies:__scene.enemies.length}));
  // upgrade a tower through tier 4 and jump to boss wave
  const r3=await p.evaluate(()=>{ const s=__scene,t=s.towers[0]; t.tier=3;t.branch=0; s.refreshPips(t); s.openPanel(s.towers[0]); s.closePanel(); s.wave=9; s.waveActive=false; s.spawnQ=[]; s.enemies.forEach(e=>{e.dead=true;e.spr.destroy();e.bar.destroy();}); s.enemies=[]; s.startWave(); s.openPanel(s.towers[1]); return s.stats(t).name; });
  await p.waitForTimeout(4000); const r4=await p.evaluate(()=>{ const s=__scene; return {boss:!!s.boss, phase:s.boss&&s.boss.phase}; });
  await p.evaluate(()=>{ const b=__scene.boss; __scene.damage(b,b.max*0.5,'sonic'); }); await p.waitForTimeout(1500);
  await p.screenshot({path:root+'/tests/shot_boss.png'}); const r5=await p.evaluate(()=>__scene.boss.phase);
  await p.evaluate(()=>{ const s=__scene; s.spawnQ=[]; s.enemies.forEach(e=>s.kill(e)); }); await p.waitForTimeout(3000);
  const r6=await p.evaluate(()=>({scene:__game.scene.getScenes(true).map(x=>x.scene.key), save:JSON.parse(localStorage.getItem('gxhub_wotw_save_v2'))}));
  await p.screenshot({path:root+'/tests/shot_end.png'});
  // progression screens + worlds
  await p.evaluate(()=>{ Progress.addXP(3000,'david'); __game.scene.getScenes(true).forEach(x=>__game.scene.stop(x.scene.key)); __game.scene.start('BattlePass'); }); await p.waitForTimeout(600);
  const bp=await p.evaluate(()=>({tier:Progress.bpTier(),claimed:Progress.bpClaimAll(),bal:Tokens.balance()})); await p.evaluate(()=>__game.scene.getScene('BattlePass').scene.restart()); await p.waitForTimeout(400); await p.screenshot({path:root+'/tests/shot_battlepass.png'});
  await p.evaluate(()=>{ __game.scene.stop('BattlePass'); __game.scene.start('Profile'); }); await p.waitForTimeout(500); await p.screenshot({path:root+'/tests/shot_profile.png'});
  await p.evaluate(()=>{ __game.scene.stop('Profile'); __game.scene.start('WorldMap'); }); await p.waitForTimeout(500); await p.screenshot({path:root+'/tests/shot_worlds.png'});
  await p.evaluate(()=>{ __game.scene.stop('WorldMap'); __game.scene.start('LevelMap',{world:'jericho'}); }); await p.waitForTimeout(500); await p.screenshot({path:root+'/tests/shot_levelmap.png'});
  const det=await p.evaluate(()=>{ const a=Levels.build({world:'jericho',index:5,diff:'hard'}), b=Levels.build({world:'jericho',index:5,diff:'hard'}); return {same:JSON.stringify(a.path)===JSON.stringify(b.path)&&JSON.stringify(a.waves)===JSON.stringify(b.waves), mods:a.mods, waves:a.nWaves, acc:Progress.accountLevel(), daily:Levels.dailySpec()}; });
  await p.evaluate(()=>{ __game.scene.stop('LevelMap'); __game.scene.start('Game',{hero:'moses',level:{world:'jericho',index:3,diff:'normal',mode:'level'}}); }); await p.waitForTimeout(800);
  const j=await p.evaluate(()=>{ const s=__scene; s.manna+=2000; s.placeTower('sling',400,300); s.placeTower('altar',700,300); s.speed=2; s.wave=s.L.nWaves-1; s.startWave(); return {name:s.L.name,mods:s.L.mods,n:s.L.nWaves}; });
  await p.waitForTimeout(3000); const j2=await p.evaluate(()=>({boss:__scene.boss&&__scene.boss.type,name:__scene.bossName&&__scene.bossName.text})); await p.screenshot({path:root+'/tests/shot_jericho.png'});
  await p.evaluate(()=>{ const s=__scene; s.spawnQ=[]; s.enemies.forEach(e=>s.kill(e)); }); await p.waitForTimeout(2500);
  const j3=await p.evaluate(()=>({scene:__game.scene.getScenes(true).map(x=>x.scene.key),stars:Levels.stars('jericho',3,'normal')}));
  await p.evaluate(()=>{ __game.scene.getScenes(true).forEach(x=>__game.scene.stop(x.scene.key)); __game.scene.start('Game',{hero:'david',level:{world:'elah',index:0,diff:'normal',mode:'endless',seed:'elah:endless'}}); }); await p.waitForTimeout(600);
  const en=await p.evaluate(()=>{ const s=__scene; s.wave=9; s.startWave(); return {total:s.waveTotal(), boss:s.L.waves[9].some(g=>g[0]==='goliath')}; });
  console.log(JSON.stringify({bp,det,j,j2,j3,en}));
  console.log(JSON.stringify({r1,r2,r3,r4,r5,r6,errs},null,1)); await b.close(); srv.close(); process.exit(errs.length?1:0); })();
